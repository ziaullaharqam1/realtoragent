# PropPilot ai-agent (Next.js) — local / Vercel
# Copy to .env.local for local overrides.

# Leave DATABASE_URL unset (or set DEMO_MODE=true) for in-memory demo on Vercel.
DEMO_MODE=true
# DATABASE_URL=postgresql://proppilot:proppilot@127.0.0.1:15432/proppilot
# REDIS_URL=redis://127.0.0.1:16379
REDIS_PROVIDER=ioredis
# For Vercel production with Redis:
# REDIS_PROVIDER=upstash
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

OBJECT_STORAGE_PROVIDER=memory
# OBJECT_STORAGE_PROVIDER=minio
# OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:19000
# OBJECT_STORAGE_ACCESS_KEY=minioadmin
# OBJECT_STORAGE_SECRET_KEY=minioadmin
# OBJECT_STORAGE_BUCKET=proppilot
# OBJECT_STORAGE_REGION=us-east-1
# For Vercel: OBJECT_STORAGE_PROVIDER=vercel-blob and BLOB_READ_WRITE_TOKEN=

GATEWAY_MODE=demo
TENANT_DEFAULT=default
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
# Optional n8n bridge
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=

NEXT_PUBLIC_APP_NAME=PropPilot
